# ============================================================
# FLUENT WEBSITE — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local (or any file with real secrets) to git.
#
# Variables prefixed NEXT_PUBLIC_ are bundled into client-side JavaScript
# and are visible to anyone who views your site's source. Only put values
# there that are safe to expose publicly (Paddle's client-side token is
# explicitly designed to be public — see PADDLE_SETUP.md).
#
# Everything WITHOUT the NEXT_PUBLIC_ prefix stays server-side only and
# is never sent to the browser. Secrets belong here.
# ============================================================


# ---------------------------------------------------------------
# PADDLE — ENVIRONMENT
# ---------------------------------------------------------------
# "sandbox" while developing/testing. Only switch to "production"
# once you have live Paddle credentials and have completed
# PRODUCTION_CHECKLIST.md.
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox


# ---------------------------------------------------------------
# PADDLE — CLIENT-SIDE (safe to expose in the browser)
# ---------------------------------------------------------------
# Found in: Paddle Dashboard > Developer Tools > Authentication >
# Client-side tokens. This token is designed by Paddle to be public —
# it can only open checkouts, it cannot read or modify your account.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=


# ---------------------------------------------------------------
# PADDLE — SERVER-SIDE SECRETS (never expose to the browser)
# ---------------------------------------------------------------
# Found in: Paddle Dashboard > Developer Tools > Authentication > API keys.
# Used by the server to query the Paddle API (e.g. to double check a
# transaction's status). Keep this out of any NEXT_PUBLIC_ variable.
PADDLE_API_KEY=

# Found in: Paddle Dashboard > Developer Tools > Notifications > (your
# webhook destination) > "Secret key". Paddle generates one secret PER
# notification destination — if you create a new webhook endpoint later
# (e.g. for production), you'll get a different secret.
PADDLE_WEBHOOK_SECRET=


# ---------------------------------------------------------------
# PADDLE — PRICE IDS
# ---------------------------------------------------------------
# Found in: Paddle Dashboard > Catalog > Products > (product) > Prices.
# These are created by YOU in the Paddle dashboard — Claude cannot
# generate or guess these. See PADDLE_SETUP.md for exact steps.
# Format looks like: pri_01h1vjfevh5etwq3rb416a23h2
PADDLE_FLUENT_PRICE_ID=
PADDLE_COMPLETE_PRICE_ID=


# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
# Local dev default: SQLite file, zero setup required.
# For production, point this at Postgres/MySQL — see PRODUCTION_CHECKLIST.md.
DATABASE_URL="file:./dev.db"


# ---------------------------------------------------------------
# DOWNLOAD SECURITY
# ---------------------------------------------------------------
# Random 32+ byte secret used to sign download-access tokens.
# Generate one with: openssl rand -hex 32
# If this leaks, anyone can forge a download link — treat it like a
# password.
DOWNLOAD_TOKEN_SECRET=

# How long a generated download link stays valid, in hours.
# Customers can always request a fresh link via /download (see README).
DOWNLOAD_LINK_TTL_HOURS=72

# Where product files actually live. Local dev can use "local" (serves
# from /private-assets, not committed to git). Production should use
# "s3" or another object store with signed URLs — see PRODUCTION_CHECKLIST.md.
DOWNLOAD_STORAGE_DRIVER=local
DOWNLOAD_STORAGE_BUCKET=
DOWNLOAD_STORAGE_REGION=
DOWNLOAD_STORAGE_ACCESS_KEY_ID=
DOWNLOAD_STORAGE_SECRET_ACCESS_KEY=


# ---------------------------------------------------------------
# EMAIL (transactional only — see lib/email/service.ts)
# ---------------------------------------------------------------
# This codebase is written against a generic transactional-email
# interface so you can plug in Resend, Postmark, SendGrid, etc.
# without touching application logic. See lib/email/service.ts.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=orders@yourdomain.com
EMAIL_FROM_NAME=FLUENT
SUPPORT_EMAIL=support@yourdomain.com


# ---------------------------------------------------------------
# SITE
# ---------------------------------------------------------------
# Used to build absolute URLs (email links, webhook docs, OG tags).
# No trailing slash. In local dev this is usually http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------
# ANALYTICS (all optional — see lib/analytics.ts)
# ---------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
